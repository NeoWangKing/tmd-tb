\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces （原文 FIG.~10）(a) 与图 4 相同，但计算曲线改用更小的展宽 0.03~eV（全宽）。 (b) 按式 (18) 定义的激子联合态密度（JDOS）。 所用洛伦兹展宽全宽为 0.01~eV，但在低能区取 0.001~eV 以便分辨单个束缚激子能级。 逆参与比（IPR）按式 (A1) 计算，未作任何展宽。}}{19}{figure.10}\protected@file@percent }
\newlabel{fig:10}{{10}{19}{（原文 FIG.~10）(a) 与图 4 相同，但计算曲线改用更小的展宽 0.03~eV（全宽）。 (b) 按式 (18) 定义的激子联合态密度（JDOS）。 所用洛伦兹展宽全宽为 0.01~eV，但在低能区取 0.001~eV 以便分辨单个束缚激子能级。 逆参与比（IPR）按式 (A1) 计算，未作任何展宽。}{figure.10}{}}
