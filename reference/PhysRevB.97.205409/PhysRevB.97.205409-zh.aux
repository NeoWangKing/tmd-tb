\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces （原文 FIG.~2）BSE 最低本征值的能量（$E_A=1.775$~eV，暗态，参见图 3(a)） 随布里渊区均匀采样总点数 $N_k$ 的变化。 水平虚线表示对不同正则化方案下所有曲线做联合外推得到的值。 阴影带标出外推结果 $\pm 20$~meV 的能量区间。}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:2}{{2}{7}{（原文 FIG.~2）BSE 最低本征值的能量（$E_A=1.775$~eV，暗态，参见图 3(a)） 随布里渊区均匀采样总点数 $N_k$ 的变化。 水平虚线表示对不同正则化方案下所有曲线做联合外推得到的值。 阴影带标出外推结果 $\pm 20$~meV 的能量区间。}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces （原文 FIG.~3）(a) 本工作得到的理论激子谱低能部分与文献 [27,30] 测得的 A、B 峰能量的比较 （注意文献 [30] 中对标记为 $A_{2s}^*$、$A_{3s}^*$ 的峰指认并不唯一）。 把能量整体刚性移动 $+0.07$~eV（见正文）之后，理论谱极好地再现了实验 A、B 峰的位置。 水平虚线表示 2.18~eV 处的单粒子能隙（$2.18=2.12+0.07$）。 (b) 按式 (18) 定义的激子联合态密度，已整体移动 $+0.07$~eV。 所用洛伦兹展宽的全宽为 0.1~eV，但在低能区（插图中放大显示）取 0.001~eV，以便分辨单个束缚激子能级。}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:3}{{3}{8}{（原文 FIG.~3）(a) 本工作得到的理论激子谱低能部分与文献 [27,30] 测得的 A、B 峰能量的比较 （注意文献 [30] 中对标记为 $A_{2s}^*$、$A_{3s}^*$ 的峰指认并不唯一）。 把能量整体刚性移动 $+0.07$~eV（见正文）之后，理论谱极好地再现了实验 A、B 峰的位置。 水平虚线表示 2.18~eV 处的单粒子能隙（$2.18=2.12+0.07$）。 (b) 按式 (18) 定义的激子联合态密度，已整体移动 $+0.07$~eV。 所用洛伦兹展宽的全宽为 0.1~eV，但在低能区（插图中放大显示）取 0.001~eV，以便分辨单个束缚激子能级。}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}线性光学电导率}{9}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces （原文 FIG.~4）文献 [27] 与 [88] 报道的室温下二氧化硅上 MoS$_2$ 单层线性光学电导率实验曲线（黑色）， 与我们含（蓝色）与不含（红色）粒子-空穴相互作用的结果对比（$N_c=8$，$N_v=2$，$N_k=60$）。 计算得到的 $\sigma (\omega )$ 额外加了 0.136~eV（全宽）的能量无关洛伦兹展宽， 以反映实验上 A、B 激子处的展宽。高能处衰减到零是人为的： BSE 对角化所用能带条数有限，使计算谱只在约 3.5~eV 以下完整。 尽管如此，为完整起见这里仍给出这些能带所覆盖的整个范围。}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:4}{{4}{10}{（原文 FIG.~4）文献 [27] 与 [88] 报道的室温下二氧化硅上 MoS$_2$ 单层线性光学电导率实验曲线（黑色）， 与我们含（蓝色）与不含（红色）粒子-空穴相互作用的结果对比（$N_c=8$，$N_v=2$，$N_k=60$）。 计算得到的 $\sigma (\omega )$ 额外加了 0.136~eV（全宽）的能量无关洛伦兹展宽， 以反映实验上 A、B 激子处的展宽。高能处衰减到零是人为的： BSE 对角化所用能带条数有限，使计算谱只在约 3.5~eV 以下完整。 尽管如此，为完整起见这里仍给出这些能带所覆盖的整个范围。}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}C 激子的性质}{11}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces （原文 FIG.~5）动量空间中的代表性激子波函数，只包含离 $E_F$ 最近的两条导带与两条价带 （$N_k=60$，$N_c=N_v=2$）。 (a) MoS$_2$ 第一布里渊区（虚线）与我们在 $k$ 采样中使用的等价倒格原胞（实心菱形）示意图。 $\Gamma $ 点位于采样域的顶点处，$M=(\pi /a,-\pi /\sqrt  3a)$，$K'=(4\pi /3a,0)$，$K=(8\pi /3a,0)$。 左栏为用文献 [13] 的紧束缚模型得到的波函数，右栏用文献 [59] 的 SK 参数化。 第二行 [(b)、(c)] 给出与光学电导率中 A 峰相关的某个波函数对应的概率分布密度图。 底部两行 [(d)--(g)] 给出 C 激子区域内的代表性波函数。坐标轴单位为 \r A$^{-1}$。色标为对数。}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:5}{{5}{13}{（原文 FIG.~5）动量空间中的代表性激子波函数，只包含离 $E_F$ 最近的两条导带与两条价带 （$N_k=60$，$N_c=N_v=2$）。 (a) MoS$_2$ 第一布里渊区（虚线）与我们在 $k$ 采样中使用的等价倒格原胞（实心菱形）示意图。 $\Gamma $ 点位于采样域的顶点处，$M=(\pi /a,-\pi /\sqrt 3a)$，$K'=(4\pi /3a,0)$，$K=(8\pi /3a,0)$。 左栏为用文献 [13] 的紧束缚模型得到的波函数，右栏用文献 [59] 的 SK 参数化。 第二行 [(b)、(c)] 给出与光学电导率中 A 峰相关的某个波函数对应的概率分布密度图。 底部两行 [(d)--(g)] 给出 C 激子区域内的代表性波函数。坐标轴单位为 \AA $^{-1}$。色标为对数。}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces （原文 FIG.~6）(a) 按我们的激子计算，把光学电导率实部、激子 JDOS 与 式 (19) 给出的振子强度画在一起。 (b)、(c) 给出对 $D'$ 与 $C'$ 两个峰有贡献的代表性激子波函数， 它们的能量与光谱重已在 (a) 中标出（$N_k=60$，$N_c=8$，$N_v=2$）。坐标轴单位为 \r A$^{-1}$。 色标为对数，与图 5 相同。}}{14}{figure.6}\protected@file@percent }
\newlabel{fig:6}{{6}{14}{（原文 FIG.~6）(a) 按我们的激子计算，把光学电导率实部、激子 JDOS 与 式 (19) 给出的振子强度画在一起。 (b)、(c) 给出对 $D'$ 与 $C'$ 两个峰有贡献的代表性激子波函数， 它们的能量与光谱重已在 (a) 中标出（$N_k=60$，$N_c=8$，$N_v=2$）。坐标轴单位为 \AA $^{-1}$。 色标为对数，与图 5 相同。}{figure.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}总结}{15}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces （原文 FIG.~7）不同理论预言的 MoS$_2$ 光学电导率与 Li 及其合作者 [27]、 Jayaswal 及其合作者 [88] 的实验结果比较。 (a) 文献 [11,13,15] 中基于紧束缚的 BSE 解给出的 $\operatorname  {Re}(\sigma _{xx})$， 与我们分别基于 Ridolfi 等人 [59] 的紧束缚模型（蓝色） 和 Wu 等人 [13] 的模型（红色）的计算对比 （后者我们加了与图 4 相同的展宽；该曲线需整体移动 $+0.57$~eV 才能与 A、B 激子的实验位置相符 [13]）。 (b) 文献 [10,31,61] 中完全从头算 BSE 解给出的 $\operatorname  {Re}(\sigma _{xx})$。 由于后两者 [31,61] 以任意单位给出 $\operatorname  {Re}(\sigma _{xx})$， 我们对每条曲线做了纵向缩放以便与实验曲线直接比较。文献 [61] 的曲线取自 300~K。}}{16}{figure.7}\protected@file@percent }
\newlabel{fig:7}{{7}{16}{（原文 FIG.~7）不同理论预言的 MoS$_2$ 光学电导率与 Li 及其合作者 [27]、 Jayaswal 及其合作者 [88] 的实验结果比较。 (a) 文献 [11,13,15] 中基于紧束缚的 BSE 解给出的 $\operatorname {Re}(\sigma _{xx})$， 与我们分别基于 Ridolfi 等人 [59] 的紧束缚模型（蓝色） 和 Wu 等人 [13] 的模型（红色）的计算对比 （后者我们加了与图 4 相同的展宽；该曲线需整体移动 $+0.57$~eV 才能与 A、B 激子的实验位置相符 [13]）。 (b) 文献 [10,31,61] 中完全从头算 BSE 解给出的 $\operatorname {Re}(\sigma _{xx})$。 由于后两者 [31,61] 以任意单位给出 $\operatorname {Re}(\sigma _{xx})$， 我们对每条曲线做了纵向缩放以便与实验曲线直接比较。文献 [61] 的曲线取自 300~K。}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces （原文 FIG.~8）采用 Wu 等人 [13]（a）与 Ridolfi 等人 [59]（b）的紧束缚参数化时， 不同导带条数下的线性光学电导率。}}{17}{figure.8}\protected@file@percent }
\newlabel{fig:8}{{8}{17}{（原文 FIG.~8）采用 Wu 等人 [13]（a）与 Ridolfi 等人 [59]（b）的紧束缚参数化时， 不同导带条数下的线性光学电导率。}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces （原文 FIG.~9）采用 Wu 等人 [13]（a）与 Ridolfi 等人 [59]（b）的紧束缚参数化时， “全能带”模型（$N_c=8$，$N_v=2$，$N_k=60$）与“仅偶宇称能带”模型（$N_c=4$，$N_v=2$，$N_k=60$） 给出的线性光学电导率对比。}}{18}{figure.9}\protected@file@percent }
\newlabel{fig:9}{{9}{18}{（原文 FIG.~9）采用 Wu 等人 [13]（a）与 Ridolfi 等人 [59]（b）的紧束缚参数化时， “全能带”模型（$N_c=8$，$N_v=2$，$N_k=60$）与“仅偶宇称能带”模型（$N_c=4$，$N_v=2$，$N_k=60$） 给出的线性光学电导率对比。}{figure.9}{}}
